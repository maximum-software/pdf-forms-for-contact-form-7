# Distribution ignore file
# This file is used when packaging the plugin for distribution
# Files/directories listed here are excluded from the final zip

# Build & release artifacts
.distignore
/build
/dist
/svn

# Dev tooling
.editorconfig
.gitignore
.git
.vscode
.idea
composer.lock
docs
vendor/bin
vendor/composer
vendor/autoload.php

# Env
.env
.env.example

# Plugin assets (not shipped in distribution)
assets/icon-128x128.png
assets/icon-256x256.png
assets/icon.svg
assets/screenshot-1.png
assets/screenshot-2.png
assets/screenshot-3.png
assets/BrowserStack.png

# Select2: ship only the minified assets actually enqueued
vendor/select2/select2/*
!vendor/select2/select2/dist
vendor/select2/select2/dist/*
!vendor/select2/select2/dist/css
vendor/select2/select2/dist/css/*
!vendor/select2/select2/dist/css/select2.min.css
vendor/select2/select2/dist/js/*
!vendor/select2/select2/dist/js/select2.full.min.js
